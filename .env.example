# FleetPulse local configuration example.
# Copy this file to `.env` and adjust values for your environment.
# Never commit real secrets or credentials to `.env`.

# Human-readable application name (used as the FastAPI title).
APP_NAME=FleetPulse API

# Application version reported by the API and OpenAPI schema.
APP_VERSION=0.1.0

# Runtime environment: development | staging | production | test
# OpenAPI documentation is only exposed in development.
APP_ENV=development

# Python log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Local PostgreSQL container credentials (Docker Compose).
# These values are for local development only and are not production secrets.
POSTGRES_DB=fleetpulse
POSTGRES_USER=fleetpulse
POSTGRES_PASSWORD=fleetpulse
POSTGRES_PORT=5432

# SQLAlchemy async connection URL (asyncpg driver).
# Use the same values as the POSTGRES_* variables above.
DATABASE_URL=postgresql+asyncpg://fleetpulse:fleetpulse@localhost:5432/fleetpulse

# Async connection pool settings (optional; defaults shown).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=5
